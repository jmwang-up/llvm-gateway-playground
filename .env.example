ENVIRONMENT=development
CLIENT_API_KEYS=frontend:replace-with-frontend-key,worker:replace-with-worker-key

REDIS_URL=redis://redis:6379/0

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-5-mini

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-20250514

RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=1
MAX_CONCURRENT_REQUESTS=5
CONCURRENCY_LEASE_SECONDS=180

CACHE_TTL_SECONDS=300
CACHE_LOCK_SECONDS=30
CACHE_LOCK_WAIT_SECONDS=5

CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_SECONDS=30
PROVIDER_TIMEOUT_SECONDS=30
TOTAL_TIMEOUT_SECONDS=75

